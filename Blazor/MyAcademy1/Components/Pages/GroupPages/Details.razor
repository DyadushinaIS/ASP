@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy1.Models
@inject IDbContextFactory<MyAcademy1.Models.PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Group</h2>
    <hr />
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">GroupName</dt>
            <dd class="col-sm-10">@group.GroupName</dd>
            <dt class="col-sm-2">Direction</dt>
            <dd class="col-sm-10">@group.Direction</dd>
            <dt class="col-sm-2">DirectionNavigation</dt>
            <dd class="col-sm-10">@group.DirectionNavigation</dd>
            <dt class="col-sm-2">Students</dt>
            <dd class="col-sm-10">@group.Students</dd>
        </dl>
        <div>
            <a href="@($"/groups/edit?groupid={group.GroupId}")">Edit</a> |
            <a href="@($"/groups")">Back to List</a>
        </div>
    }
</div>

@code {
    private Group? group;

    [SupplyParameterFromQuery]
    private int GroupId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        group = await context.Groups.FirstOrDefaultAsync(m => m.GroupId == GroupId);

        if (group is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
