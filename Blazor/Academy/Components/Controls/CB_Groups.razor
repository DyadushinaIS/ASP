@using Academy.Models;
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<h5>group</h5>

<div class="mb-3">
    <span class="text-danger">*</span>
    <label for="group" class="form-label">group:</label>
    @* <InputNumber id="group" @bind-Value="Student.group" class="form-control" aria-required="true" /> *@
    <InputSelect id="group" @bind-Value="Student.group" class="form-control">
        @using (AcademyContext context = DbFactory.CreateDbContext())
        {
            @foreach (Group group in context.Groups)
            {
                <option value="@group.group_id">@group.group_name</option>
            }
        }
    </InputSelect>
    <ValidationMessage For="() => Student.group" class="text-danger" />
</div>

@code 
{
	[Parameter]
	public Academy.Models.Student Student{ get; set; }


}
